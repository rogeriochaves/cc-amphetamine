{
  "name": "cc-amphetamine",
  "version": "0.1.0",
  "description": "Shows a clawd icon in the menu bar while Claude Code is active, pairs with Amphetamine for sleep prevention",
  "main": "amphetamine.js",
  "bin": {
    "cc-amphetamine": "./amphetamine.js"
  },
  "scripts": {
    "start": "pnpm run server",
    "caffeinate": "node amphetamine.js caffeinate",
    "uncaffeinate": "node amphetamine.js uncaffeinate",
    "status": "node amphetamine.js status",
    "version": "node amphetamine.js version",
    "server": "npx electron clawd.js server",
    "lint": "eslint --fix *.js src/*.js || echo 'eslint not installed'",
    "format": "prettier --write *.js src/*.js || echo 'prettier not installed'"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "plugin",
    "sleep",
    "sleep-prevention",
    "amphetamine",
    "system-tray",
    "electron"
  ],
  "author": {
    "name": "Rogerio Chaves"
  },
  "license": "MIT",
  "dependencies": {
    "electron": "^39.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rogeriochaves/cc-amphetamine.git"
  },
  "os": [
    "darwin"
  ]
}
